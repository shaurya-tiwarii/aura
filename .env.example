# =============================================================================
# AURA - Environment configuration template
# =============================================================================
# Copy this file to `.env` (backend) and `frontend/.env.local` (frontend) and
# fill in the values you have. NEVER commit a real `.env` file.
#
# AURA is designed to run with ZERO paid services. Every variable below is
# either optional or has a working local default. The table in README.md
# ("Credential matrix") states exactly which feature each variable unlocks and
# what happens when it is absent.
# =============================================================================


# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
APP_ENV=development                       # development | production
APP_NAME=AURA
APP_VERSION=1.0.0                         # informational; reported in logs/health
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                        # console | json  (use json in prod)

# Signs local-provider session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED. The app refuses to start in production if this is unset or default.
SECRET_KEY=dev-only-insecure-change-me

# Comma-separated list of origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL is the supported production database.
#   Docker (docker-compose up db):
#     postgresql+psycopg://aura:aura@localhost:5432/aura
#   Supabase (Project Settings -> Database -> Connection string -> URI):
#     postgresql+psycopg://postgres:<password>@<host>:5432/postgres
#
# If unset, AURA falls back to a local SQLite file (./aura.db) so the project
# runs with no database server at all. Feature-complete for demo purposes;
# Postgres is required for production and for JSONB-backed query performance.
DATABASE_URL=

# Docker Compose only (required; never use a checked-in/default password).
# POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# local    - self-contained auth (argon2 password hashing + signed JWTs).
#            Needs no external account. Intended for development and offline demos.
# supabase - verifies Supabase-issued JWTs. Requires the three values below.
AUTH_PROVIDER=local

SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=             # deprecated alias for SUPABASE_ANON_KEY (newer Supabase naming)
# Project Settings -> API -> JWT Settings -> JWT Secret.
# Legacy HS256 projects only: shared secret used to verify token signatures.
# Newer Supabase projects sign with JWT Signing Keys (ES256) -- those verify
# against the project's JWKS endpoint and this stays empty. Optional either way.
SUPABASE_JWT_SECRET=
# Expected `aud` claim on Supabase-issued JWTs (default matches the Supabase default).
SUPABASE_JWT_AUDIENCE=authenticated

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14


# -----------------------------------------------------------------------------
# AI - Google Gemini
# -----------------------------------------------------------------------------
# Free-tier key from https://aistudio.google.com/app/apikey
# Without it, AI content generation and the assistant are disabled and the UI
# says so explicitly. All crawling, scoring, and recommendation engines are
# deterministic application logic and work with no AI key at all.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=8192


# -----------------------------------------------------------------------------
# Crawler safety limits  (spec section 21 - do not build an aggressive crawler)
# -----------------------------------------------------------------------------
CRAWLER_MAX_PAGES=20                      # hard cap on pages per scan
CRAWLER_MAX_DEPTH=3                       # link depth from the entry URL
CRAWLER_TIMEOUT_SECONDS=15                # per-request timeout
CRAWLER_DELAY_SECONDS=0.5                 # politeness delay between requests
CRAWLER_MAX_CONCURRENCY=4
CRAWLER_MAX_RESPONSE_BYTES=5242880        # 5 MiB; larger responses are skipped
CRAWLER_MAX_LINK_CHECKS=50               # distinct external URLs probed per scan for the broken-links rule (0 disables)
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_USER_AGENT=AURABot/1.0 (+https://github.com/aura-platform/aura)

# Allow crawling private/loopback addresses. MUST stay false outside tests:
# it is the SSRF guard that stops a user pointing the crawler at internal hosts.
CRAWLER_ALLOW_PRIVATE_HOSTS=false


# -----------------------------------------------------------------------------
# Token encryption
# -----------------------------------------------------------------------------
# Encrypts OAuth access/refresh tokens at rest (platform_connections table).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before any real publishing connector can be used.
TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Publishing connectors
# -----------------------------------------------------------------------------
# Each connector is fully implemented against its official API. When the
# credentials below are absent the connector is exposed in DEMO mode: the
# complete publish/schedule workflow runs and is stored, and every resulting
# record is labelled "Simulated" in the API and the UI. Simulated results are
# never presented as real (spec section 46).

PUBLIC_BASE_URL=http://localhost:8000     # OAuth redirect base

# WordPress.com REST API - https://developer.wordpress.com/apps/
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# LinkedIn - https://www.linkedin.com/developers/apps
# Posting needs the `w_member_social` scope, which requires app review.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit - https://www.reddit.com/prefs/apps  (type: web app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:aura:1.0 (by /u/your_username)


# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_BACKOFF_SECONDS=300
SCHEDULER_MISFIRE_GRACE_SECONDS=3600


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20             # login/register/refresh/password endpoints
RATE_LIMIT_ANALYSIS_PER_HOUR=20           # website scans are expensive
RATE_LIMIT_AI_PER_HOUR=60                 # protects the Gemini free tier


# -----------------------------------------------------------------------------
# Frontend  (copy into frontend/.env.local)
# -----------------------------------------------------------------------------
# The frontend tries NEXT_PUBLIC_API_URL first, then NEXT_PUBLIC_API_BASE_URL,
# then defaults to http://127.0.0.1:8000. Set either one; API_URL wins.
# NOTE (Docker): NEXT_PUBLIC_* values are baked into the frontend at BUILD time
# via Compose build args, which interpolate from the ROOT .env — so these two
# Supabase values must ALSO be set in the root .env, not only here.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
